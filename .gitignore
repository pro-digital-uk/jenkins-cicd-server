# ============================================================================
# Terraform Files
# ============================================================================

# Local .terraform directories
.terraform/
.terraform.lock.hcl

# .tfstate files - NEVER COMMIT THESE (contain sensitive data)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files - contain sensitive data like passwords & secrets
*.tfvars
*.tfvars.json

# Override files for local testing
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform apply lock files
.terraform.tfstate.lock.info

# CLI configuration files
.terraformrc
terraform.rc

# Graph output files
*.dot

# Plan output files
*.tfplan
tfplan

# ============================================================================
# Private Keys & Credentials
# ============================================================================

# SSH private keys generated by key_pair module
*.pem
*.pub
jenkins-server-key*

# AWS credentials
.aws/credentials
.aws/config

# Environment secrets
.env
.env.local
.env.*.local

# ============================================================================
# IDE & Editor Files
# ============================================================================

.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Editor temp files
.vim/
*.bak
*.tmp

# ============================================================================
# OS Files
# ============================================================================

.DS_Store
Thumbs.db
.AppleDouble
.LSOverride
._*

# ============================================================================
# Logs & Temporary Files
# ============================================================================

*.log
terraform.log
crash.*
debug*

# Temporary directories
tmp/
temp/

# ============================================================================
# Build & Distribution
# ============================================================================

dist/
build/
*.zip
*.tar.gz

# ============================================================================
# CI/CD Artifacts
# ============================================================================

.github/workflows/*.log
.gitlab-ci.log

# ============================================================================
# Project Specific
# ============================================================================

# Jenkins setup logs
jenkins-setup.log

# Crash dumps
core.*
